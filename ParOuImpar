#include <stdio.h>

void verificarParOuImpar(int n) {
    if (n % 2 == 0) {
        printf("PAR\n");
    } else {
        printf("IMPAR\n");
    }
}

int main() {
    int N, i = 1, num;

    scanf("%d", &N);

    if (N > 0) {
        do {
            scanf("%d", &num);
            verificarParOuImpar(num);
            i++;
        } while (i <= N);
    }

    return 0;
}



